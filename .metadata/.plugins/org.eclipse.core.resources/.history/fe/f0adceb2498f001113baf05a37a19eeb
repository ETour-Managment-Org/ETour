# The defaults below are the literal string "not-configured", NOT an empty value.
#
# Spring Boot validates every OAuth2 registration when the properties bean is
# created, long before any of our code runs, and an EMPTY client-id is a hard
# startup failure:
#
#   IllegalStateException: Client id of registration 'google' must not be empty.
#
# A non-empty placeholder passes that validation, and OAuth2Properties treats
# "not-configured" as "off" - so the app starts fine with no Google credentials
# and the Continue with Google button stays hidden.
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:not-configured}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:not-configured}
spring.security.oauth2.client.registration.google.scope=openid,email,profile
spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}

etour.oauth.enabled=${OAUTH_ENABLED:false}
# In Docker the React build is served by this same application, so the browser
# never visits 5173 - set OAUTH_REDIRECT and SITE_URL to port 8080 there.
etour.oauth.redirect-uri=${OAUTH_REDIRECT:http://localhost:5173/oauth/callback}

etour.site-url=${SITE_URL:http://localhost:5173}
etour.scheduling.completion-cron=${COMPLETION_CRON:0 0 7 * * *}
