INSERT INTO tour (tour_id, tour_name, destination, days, nights, description, price,
                  category_id, subcat_id, location, tour_type,
                  stay_and_meals, add_ons, passport_and_visa, weather, do_and_dont) VALUES
 (1,'Kashmir Paradise','Srinagar - Gulmarg - Pahalgam',6,5,
  'Shikara rides on Dal Lake, meadows at Pahalgam and the gondola at Gulmarg, with one night on a traditional houseboat.',24999,26,1,'Jammu & Kashmir','DOMESTIC',
  'One night deluxe houseboat plus four nights hotel on twin sharing. Daily breakfast and dinner.',
  'Gulmarg gondola phase two. Pony ride at Baisaran valley. Saffron farm visit at Pampore.',
  'Domestic tour. A government photo ID is sufficient at every check-in.',
  'April to October pleasant, 8C to 28C. December to February snowbound, can drop below zero.',
  'DO carry layered woollens even in summer. DO NOT venture off marked trails near Gulmarg.'),
 (2,'Rajasthan Royal Heritage','Udaipur - Jodhpur - Jaisalmer - Jaipur',7,6,
  'Live like royalty across the palaces and forts of Rajasthan, from the lakes of Udaipur to the pink city of Jaipur.',45000,20,NULL,'Rajasthan','DOMESTIC',
  'Heritage hotels on twin sharing. Daily breakfast and dinner. One desert camp night with a folk dinner.',
  'Camel safari at Sam dunes. Hot air balloon over Jaipur. Vintage car ride in Udaipur.',
  'Domestic tour. Photo ID required at hotel check-in.',
  'October to March ideal, 10C to 27C. April to June can exceed 45C.',
  'DO stay hydrated and cover your head at midday. DO NOT photograph museum interiors without permission.'),
 (3,'Kerala Backwaters Bliss','Kochi - Munnar - Alleppey - Kovalam',5,4,
  'Cruise the tranquil backwaters of Alleppey aboard a traditional houseboat, explore tea gardens in Munnar and unwind at Kovalam.',32000,21,3,'Kerala','DOMESTIC',
  'One night premium houseboat, three nights resort on twin sharing. All meals on the houseboat day.',
  'Ayurvedic massage. Kathakali performance. Bamboo rafting at Periyar.',
  'Domestic tour. A government photo ID is sufficient.',
  'September to March pleasant, 18C to 32C. June to August monsoon with heavy rain.',
  'DO carry mosquito repellent. DO NOT swim in the backwaters.'),
 (4,'Goa Beach Escape','North Goa - South Goa',4,3,
  'Beach shacks, Portuguese churches and a Dudhsagar waterfall day trip across both halves of Goa.',22000,22,2,'Goa','DOMESTIC',
  'Three nights beach resort on twin sharing. Daily breakfast plus one seafood dinner.',
  'Scuba diving at Grande Island. Dudhsagar jeep safari. Casino entry.',
  'Domestic tour. Photo ID required.',
  'November to February ideal, 21C to 32C. June to September monsoon.',
  'DO respect beach shack timings. DO NOT swim beyond the red flag markers.'),
 (5,'Glimpses of Europe','Paris - Lucerne - Venice - Vienna',9,8,
  'Four countries, four cities and the Alps in between, travelling by high speed rail through Western Europe.',185000,9,4,'Europe','INTERNATIONAL',
  'Eight nights three-star central hotels on twin sharing. Daily Indian breakfast, six dinners.',
  'Eiffel Tower summit. Mount Titlis cable car. Venice gondola ride. Seine river cruise.',
  'Valid passport with six months validity plus a Schengen visa. Biometrics appointment required.',
  'May to September mild, 15C to 27C. December to February cold, near zero with snow in the Alps.',
  'DO validate rail tickets before boarding. DO NOT leave bags unattended at stations.'),
 (6,'Bali Island Escape','Kuta - Ubud - Nusa Dua',6,5,
  'Discover the temples, rice terraces and beaches of Bali with curated experiences across Ubud and Seminyak.',68000,7,6,'Indonesia','INTERNATIONAL',
  'Five nights four-star resort on twin sharing. Daily breakfast, two dinners.',
  'Mount Batur sunrise trek. Balinese spa ritual. Nusa Penida day trip.',
  'Valid passport with six months validity. Visa on arrival for Indian nationals. One passport photograph.',
  'April to October dry season, 24C to 31C. November to March humid with afternoon showers.',
  'DO dress modestly at temples, sarongs are provided. DO NOT touch offerings placed on the ground.'),
 (7,'Dubai Delight','Dubai - Abu Dhabi',5,4,
  'Desert safari, Burj Khalifa and a day at the Sheikh Zayed Grand Mosque, with an evening dhow cruise on Dubai Creek.',49999,28,5,'United Arab Emirates','INTERNATIONAL',
  'Four nights four-star hotel on twin sharing. Daily breakfast, one desert camp dinner.',
  'Burj Khalifa 148th floor upgrade. Dhow cruise dinner. Ferrari World entry.',
  'Valid passport with six months validity plus a UAE tourist visa. One photograph with a white background.',
  'November to March pleasant, 19C to 30C. June to August extreme heat above 45C.',
  'DO dress conservatively in public areas. DO NOT photograph people without permission.'),
 (8,'Leh Ladakh Expedition','Leh - Nubra - Pangong',8,7,
  'A high-altitude adventure through the dramatic Himalayan landscapes of Ladakh, including Pangong Lake and Khardung La.',52000,27,NULL,'Ladakh','DOMESTIC',
  'Hotels in Leh, camps in Nubra and Pangong on twin sharing. All meals at the camps.',
  'Motorbike rental with rider. River rafting on the Zanskar. Camel ride at Hunder.',
  'Domestic tour. Inner Line Permit arranged by us. Photo ID mandatory.',
  'June to September the only accessible window, 15C to 25C by day and near zero at night.',
  'DO acclimatise for 48 hours in Leh before travelling higher. DO NOT consume alcohol on the first two days.'),
 (9,'Char Dham Yatra','Yamunotri - Gangotri - Kedarnath - Badrinath',11,10,
  'The complete four-shrine Uttarakhand circuit with assisted treks, conducted at a pace suited to families.',38500,30,NULL,'Uttarakhand','DOMESTIC',
  'Ten nights guest houses and dharamshalas on twin sharing. All meals, pure vegetarian.',
  'Helicopter shuttle to Kedarnath. Palki and pony assistance. Priority darshan pass.',
  'Domestic tour. Photo ID plus a medical fitness certificate for the Kedarnath trek.',
  'May to June and September to October the open window, 5C to 22C. Closed in winter.',
  'DO carry prescribed medication and a raincoat. DO NOT attempt the treks with an untreated heart condition.'),
 (10,'Maldives Honeymoon Retreat','Male - Maafushi Atoll',5,4,
  'Overwater villas, house reef snorkelling and private sandbank dining for two.',89999,31,NULL,'Maldives','INTERNATIONAL',
  'Four nights overwater villa on twin sharing. All meals plus one candlelight dinner.',
  'Sunset dolphin cruise. Couple spa ritual. Private sandbank picnic.',
  'Valid passport with six months validity. Free visa on arrival for Indian nationals.',
  'November to April dry and sunny, 26C to 31C. May to October occasional rain.',
  'DO use reef-safe sunscreen. DO NOT remove coral or shells from the reef.'),
 (11,'Goa Carnival Special','Panaji - North Goa',4,3,
  'Time your beach break with the Goa Carnival - float parades, live music and Portuguese heritage across three days.',26500,33,7,'Goa','DOMESTIC',
  'Three nights beach resort on twin sharing. Daily breakfast plus one carnival dinner.',
  'Reserved parade grandstand seating. Fontainhas heritage walk. Sunset cruise on the Mandovi.',
  'Domestic tour. Photo ID required.',
  'February carnival week is dry and warm, 22C to 32C.',
  'DO reach the parade route an hour early. DO NOT carry glass bottles into the parade zone.'),
 (12,'Sri Lanka Test Match Tour','Colombo - Galle',6,5,
  'Follow the touring side across two Test venues, with beach and fort time between match days.',57500,34,8,'Sri Lanka','INTERNATIONAL',
  'Five nights three-star hotel on twin sharing. Daily breakfast.',
  'Match ticket upgrades. Galle fort walking tour. Whale watching at Mirissa.',
  'Valid passport with six months validity. ETA required before travel.',
  'December to March dry on the west coast. May to September monsoon.',
  'DO carry a hat and sunscreen for match days. DO NOT bring glass bottles into the stadium.'),
 (13,'Rann Utsav Desert Festival','Bhuj - Dhordo White Rann',4,3,
  'Three nights in a tented city on the white salt desert, with folk performances, handicraft villages and a full moon night.',29500,33,7,'Gujarat','DOMESTIC',
  'Three nights premium AC tent on twin sharing. All meals, pure vegetarian Kutchi thali.',
  'Full moon Rann visit. Camel cart ride. Bhuj handicraft village tour. ATV ride on the salt flats.',
  'Domestic tour. Photo ID plus a Rann permit arranged by us.',
  'November to February the festival window, 12C to 29C by day and cold at night.',
  'DO carry sunglasses, the salt glare is intense. DO NOT drive private vehicles onto the salt flats.'),
 (14,'Monsoon Magic Malshej','Malshej Ghat - Bhandardara - Igatpuri',3,2,
  'The Western Ghats at their greenest - roadside waterfalls, fort walks in the mist and a lakeside night at Bhandardara.',14500,3,1,'Maharashtra','DOMESTIC',
  'Two nights hillside resort on twin sharing. All meals, with hot bhajji and chai on arrival.',
  'Guided Harishchandragad trail. Kayaking on Arthur Lake. Night sky session at Bhandardara.',
  'Domestic tour. Photo ID required.',
  'June to September is the whole point, 19C to 27C with heavy continuous rain.',
  'DO carry a poncho rather than an umbrella, the wind is strong. DO NOT enter waterfall pools, the current is deceptive.'),
 (15,'Cricket Dhamaka - Australia Test Series','Melbourne - Sydney',10,9,
  'The Boxing Day Test at the MCG and the New Year Test at the SCG, with the coast and the city in between.',245000,5,8,'Australia','INTERNATIONAL',
  'Nine nights four-star city hotels on twin sharing. Daily breakfast, three dinners.',
  'Premium stand seating upgrade. MCG museum tour. Great Ocean Road day trip. Sydney Harbour dinner cruise.',
  'Valid passport with six months validity plus an Australian visitor visa. Allow four weeks for processing.',
  'December and January are Australian summer, 18C to 30C.',
  'DO apply sunscreen every two hours, the UV index is extreme. DO NOT bring outside alcohol into the grounds.'),
 (16,'Assam Tea Trails and Kaziranga','Guwahati - Kaziranga - Jorhat',6,5,
  'Elephant-back safari among one-horned rhinos at Kaziranga, then the tea bungalows and river islands of upper Assam.',34500,18,NULL,'Assam','DOMESTIC',
  'Five nights - two in a heritage tea bungalow, three in a forest lodge, on twin sharing. All meals.',
  'Elephant safari at Kaziranga. Tea tasting with the estate manager. Majuli island ferry and mask-making village.',
  'Domestic tour. Photo ID required. Foreign nationals need a protected area permit.',
  'November to April is the open season, 10C to 28C. The park closes mid-May for the monsoon.',
  'DO wear muted colours on safari. DO NOT step out of the jeep inside the park.'),
 (17,'Goa Music Weekend','Vagator - Anjuna',3,2,
  'Three days across the main stage and the beach stages, with a hillside hotel five minutes from the arena.',18900,35,NULL,'Goa','DOMESTIC',
  'Two nights boutique hotel on twin sharing. Daily breakfast and late checkout on the final day.',
  'Festival wristband upgrade. Shuttle to and from the arena. Anjuna flea market walk.',
  'Domestic tour. Photo ID mandatory for wristband collection. Strictly 18 and over.',
  'Late December is dry and warm, 21C to 31C, cool after midnight.',
  'DO keep your wristband on for the full three days. DO NOT carry professional cameras into the arena.'),
 (18,'Austria and Switzerland Alpine','Zurich - Lucerne - Innsbruck - Vienna',8,7,
  'The Alps at their most theatrical - two glacier excursions, a scenic rail pass and the imperial cities at either end.',198000,10,4,'Europe','INTERNATIONAL',
  'Seven nights four-star hotels on twin sharing. Daily breakfast, five dinners including one Tyrolean evening.',
  'Jungfraujoch railway to the Top of Europe. Swarovski Crystal Worlds. Vienna State Opera performance.',
  'Valid passport with six months validity plus a Schengen visa. Proof of travel insurance required.',
  'June to September mild, 14C to 25C. December to March is ski season with heavy snow on the passes.',
  'DO carry your rail pass and passport on every excursion. DO NOT underestimate the cold at altitude, it is below zero year round.'),
 (19,'Cricket Dhamaka in England','London - Manchester - Birmingham',9,8,
  'Two Tests, three cities and a Lords tour, with rail between venues and a free day for the Cotswolds.',215000,11,8,'England','INTERNATIONAL',
  'Eight nights three-star central hotels on twin sharing. Daily breakfast, four dinners.',
  'Lords Long Room tour. Old Trafford pavilion seating. Cotswolds day trip. Thames evening cruise.',
  'Valid passport with six months validity plus a UK Standard Visitor visa. Biometrics and bank statements required.',
  'June to August is the cricket season, 15C to 24C with intermittent rain even in summer.',
  'DO pack a light waterproof, play stops for rain. DO NOT expect refunds for weather-shortened play.'),
 (20,'China with Tibet','Beijing - Xian - Lhasa',10,9,
  'The Great Wall and the Terracotta Army, then the Qinghai-Tibet railway up to Lhasa and the Potala Palace.',152000,13,NULL,'China','INTERNATIONAL',
  'Nine nights four-star hotels on twin sharing. Daily breakfast, seven dinners including one Peking duck.',
  'Mutianyu Wall cable car. Tang dynasty dinner show in Xian. Yamdrok Lake excursion from Lhasa.',
  'Valid passport with six months validity, a Chinese visa AND a separate Tibet Travel Permit. Allow six weeks.',
  'April to June and September to October are best, 8C to 24C. Lhasa sits at 3,650m and nights are cold year round.',
  'DO spend the first day in Lhasa resting, altitude sickness is common. DO NOT discuss politics with local guides.'),
 (21,'China with Hong Kong','Beijing - Shanghai - Hong Kong',8,7,
  'Imperial Beijing, the Shanghai Bund by night, and Victoria Harbour from the Peak Tram.',138000,14,NULL,'China','INTERNATIONAL',
  'Seven nights four-star hotels on twin sharing. Daily breakfast, five dinners.',
  'Shanghai Maglev to the airport. Huangpu river cruise. Victoria Peak tram and Ngong Ping cable car.',
  'Valid passport with six months validity. A Chinese visa plus a separate Hong Kong entry, which is visa-free for Indian nationals for 14 days on pre-registration.',
  'October to December is clear and mild, 18C to 26C. July to September is typhoon season.',
  'DO pre-register online for Hong Kong entry before flying. DO NOT rely on international cards, carry some cash.'),
 (22,'Sri Lanka with Cricket Dhamaka','Colombo - Kandy - Galle',7,6,
  'A Test at the SSC, the hill country by train, and the Galle ramparts at sunset.',62000,15,8,'Sri Lanka','INTERNATIONAL',
  'Six nights three-star hotels on twin sharing. Daily breakfast, four dinners.',
  'Match ticket upgrades. Kandy to Ella observation-car rail seat. Temple of the Tooth evening pooja.',
  'Valid passport with six months validity. ETA required before travel.',
  'December to March dry on the west coast, 24C to 31C. May to September monsoon.',
  'DO book the observation car early, it sells out weeks ahead. DO NOT photograph with your back to a Buddha statue.'),
 (23,'Beauty of Sri Lanka','Negombo - Sigiriya - Kandy - Mirissa',6,5,
  'The cultural triangle, the hill country railway and the southern whale coast in one loop.',48500,16,NULL,'Sri Lanka','INTERNATIONAL',
  'Five nights three-star hotels and one beach resort on twin sharing. Daily breakfast, three dinners.',
  'Sigiriya rock climb. Pinnawala elephant orphanage. Mirissa whale watching. Ambuluwawa tower.',
  'Valid passport with six months validity. ETA required before travel.',
  'December to March best on the south and west coasts, 25C to 32C.',
  'DO start the Sigiriya climb by 7am to beat the heat. DO NOT feed or touch the elephants at Pinnawala.'),
 (24,'Shimla Kufri Getaway','Shimla - Kufri - Chail',5,4,
  'The Kalka-Shimla toy train, the Mall Road evenings and the highest cricket ground in the world at Chail.',27500,23,1,'Himachal Pradesh','DOMESTIC',
  'Four nights colonial-era hotel on twin sharing. Daily breakfast and dinner.',
  'Toy train seat from Kalka. Kufri horse ride to Mahasu Peak. Ice skating rink in season.',
  'Domestic tour. Photo ID required.',
  'March to June pleasant, 15C to 28C. December to February snowfall, near zero.',
  'DO carry shoes with grip, the Mall Road slopes ice over. DO NOT expect vehicles on the Mall, it is pedestrian only.'),
 (25,'Sikkim and Gangtok Explorer','Gangtok - Tsomgo - Pelling',6,5,
  'Tsomgo Lake, the Nathu La pass on the old silk route, and Kanchenjunga at dawn from Pelling.',32500,24,1,'Sikkim','DOMESTIC',
  'Five nights hotels on twin sharing. Daily breakfast and dinner.',
  'Nathu La pass permit and drive. Ropeway over Gangtok. Yuksom day trip and Khecheopalri lake.',
  'Domestic tour. Photo ID mandatory. Protected area permits for Tsomgo and Nathu La are arranged by us.',
  'March to May and October to December are clearest, 5C to 22C. Nathu La closes in heavy snow.',
  'DO carry your permit and ID on the Nathu La drive, there are army checkpoints. DO NOT visit Nathu La if you have a heart condition, it is 4,310m.'),
 (26,'Kashmir with Vaishno Devi','Katra - Srinagar - Gulmarg',8,7,
  'The Vaishno Devi yatra from Katra, then the valley - Dal Lake, Gulmarg and Pahalgam.',41500,25,1,'Jammu & Kashmir','DOMESTIC',
  'Seven nights - two in Katra, five in the valley including one houseboat night, on twin sharing. All meals, pure vegetarian in Katra.',
  'Helicopter shuttle to Sanjichhat. Battery car on the Bhawan track. Gulmarg gondola phase two.',
  'Domestic tour. Photo ID mandatory for the yatra parchi at Katra.',
  'March to October pleasant in the valley, 8C to 28C. The Katra track is open year round.',
  'DO collect the yatra parchi before starting the climb, it is compulsory. DO NOT carry leather items into the Bhawan.'),
 (27,'Himachal Hills Explorer','Manali - Shimla',5,4,
  'Solang valley, Hadimba temple and the Mall Road at Shimla, linked by the Kullu valley road.',26500,23,1,'Himachal Pradesh','DOMESTIC',
  'Four nights hotel on twin sharing. Daily breakfast and dinner.',
  'Solang valley paragliding. Rohtang pass permit. Kufri horse ride.',
  'Domestic tour. Photo ID required at every hotel.',
  'March to June pleasant, 10C to 25C. December to February snowfall.',
  'DO carry warm layers even in summer. DO NOT attempt Rohtang without the permit.'),
 (28,'Leh to Chandigarh Road Trip','Leh - Manali - Chandigarh',9,8,
  'The full Leh-Manali highway by road, over Tanglang La and Rohtang, finishing in Chandigarh.',58000,27,1,'North India','DOMESTIC',
  'Eight nights mixed hotels and camps on twin sharing. All meals on camp days.',
  'Motorbike option with rider. Oxygen support vehicle. Rohtang pass permit.',
  'Domestic tour. Inner Line Permit arranged by us. Photo ID mandatory.',
  'June to September only. The highway closes with the first heavy snow.',
  'DO acclimatise in Leh for 48 hours first. DO NOT drive this route at night.');

